# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend (server-side proxy target; leave NEXT_PUBLIC_API_URL empty to use same-origin /api)
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=
# Research assistant (optional; without a key, matching passages are returned only).
GEMINI_API_KEY=
ASSISTANT_MODEL=
# The backend does not read .env; set these in the same PowerShell window before starting it:
# $env:GEMINI_API_KEY="your-key"; python run.py
